# A.R.I.S. - Configurações de Exemplo
# Copie este arquivo para .env e preencha as credenciais

# Logs
ARIS_LOG_LEVEL=INFO
ARIS_MAX_LOG_SIZE_MB=10

# Terminal
ARIS_PROMPT=>

# Voz
ARIS_VOICE_RATE=0
ARIS_VOICE_VOLUME=100

# ── LLM Providers (auto-detect por variáveis de ambiente) ───

# Provider 1: Groq (primário)
GROQ_API_KEY=sua_chave_groq_aqui
ARIS_CHAT_MODEL=openai/gpt-oss-120b

# Provider 2: Google Gemini (fallback)
GEMINI_API_KEY=sua_chave_gemini_aqui
# Modelo confirmado como endpoint válido (estável) na documentação oficial
# do provedor (ai.google.dev/gemini-api/docs/models, 13/10/2026).
# Raciocínio pesado: gemini-4-argon | anterior válido: gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash

# Provider 3: Ollama (local, fallback final)
# Ollama é detectado automaticamente se estiver rodando em localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# ── Providers explícitos (override do auto-detect) ──────────
# Descomente e configure providers adicionais conforme necessário.

# # Provider customizado 1
# ARIS_LLM_1_NAME=openai
# ARIS_LLM_1_API_KEY=sk-sua_chave_openai
# ARIS_LLM_1_MODEL=gpt-4o
# ARIS_LLM_1_BASE_URL=https://api.openai.com/v1
# ARIS_LLM_1_CAPABILITIES=text,vision

# # Provider customizado 2 (Anthropic via OpenAI-compatible)
# ARIS_LLM_2_NAME=anthropic
# ARIS_LLM_2_API_KEY=sk-ant-sua_chave_anthropic
# ARIS_LLM_2_MODEL=claude-sonnet-4-20250514
# ARIS_LLM_2_BASE_URL=https://api.anthropic.com/v1
# ARIS_LLM_2_CAPABILITIES=text,vision

# # Provider customizado 3 (Groq com modelo diferente)
# ARIS_LLM_3_NAME=groq-fast
# ARIS_LLM_3_API_KEY=sua_chave_groq
# ARIS_LLM_3_MODEL=llama-3.3-70b-versatile
# ARIS_LLM_3_BASE_URL=https://api.groq.com/openai/v1
# ARIS_LLM_3_CAPABILITIES=text

# Memória
# Deixe comentado para usar <projeto>/data/memory (Linux e Windows).
# Windows (drive dedicado): ARIS_MEMORY_ROOT=D:/ARIS_MEMORY
# Linux:                    ARIS_MEMORY_ROOT=/home/SEU_USUARIO/.local/share/aris/memory
# ARIS_MEMORY_ROOT=

# Segurança
ARIS_SAFETY_PASSWORD=

# ESP32 (hardware opcional)
ESP32_ENABLED=true
ESP32_WS_PORT=8766
HARDWARE_SIMULATION=false

# ── Vision Engine ──────────────────────────────────────────
ARIS_VISION_ENABLED=true
ARIS_SCREEN_VISION_ENABLED=true
ARIS_OCR_ENABLED=true
ARIS_VLM_ENABLED=true
ARIS_VLM_PROVIDER=ollama
ARIS_VLM_MODEL=
ARIS_OLLAMA_BASE_URL=http://localhost:11434
ARIS_VISION_TIMEOUT=30.0
ARIS_VISION_MAX_IMAGE_SIZE=1024

# ── Saudação Contextual ───────────────────────────────────
GREETING_TIMEZONE=America/Sao_Paulo
GREETING_LATITUDE=-23.55
GREETING_LONGITUDE=-46.63
GREETING_CITY=São Paulo
GREETING_COOLDOWN_HOURS=4

# ── Discord Bot (DM como canal principal) ──────────────────
# O bot conversa via PV (DM). Nao ha dependencia de DISCORD_CHANNEL_ID.
# DISCORD_BOT_TOKEN: Token do bot (obrigatorio)
# DISCORD_ALLOWED_USERS: User IDs autorizados (obrigatorio, separados por virgula)
# DISCORD_CHANNEL_ID: Opcional — apenas para diagnostico/administracao
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
# DISCORD_CHANNEL_ID=

# ── CLL1 (edge) ─────────────────────────────────────────
# CLL1_HOST=192.168.0.106
# CLL1_PORT=8765
# CLL1_TOKEN=seu_token_aqui
# EDGE_GROQ_API_KEY=chave_groq_edge_separada
# EDGE_MODEL=openai/gpt-oss-120b
# EDGE_RATE_LIMIT=100
