# ============================================================
# J.A.R.V.I.S. - Environment Variables
# ============================================================
# Copie este arquivo para .env e ajuste conforme necessário.
# ============================================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
JARVIS_LOG_LEVEL=INFO

# Tamanho máximo do arquivo de log em MB
JARVIS_MAX_LOG_SIZE_MB=10

# Texto do prompt de entrada
JARVIS_PROMPT=> 

